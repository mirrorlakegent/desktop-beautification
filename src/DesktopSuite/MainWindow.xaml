<Window x:Class="DesktopSuite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DesktopSuite" Height="760" Width="580" MinHeight="400" MinWidth="480">
    <ScrollViewer Name="RootScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent">
        <StackPanel Name="RootPanel" Margin="24" VerticalAlignment="Top">
            <TextBlock Text="DesktopSuite — 壁纸引擎" FontSize="20" FontWeight="Bold" Margin="0,0,0,8" Name="TitleBlock"/>
            <TextBlock Text="安全备份 · 主题切换 · 壁纸设置" FontSize="12" Margin="0,0,0,20" Opacity="0.7" Name="SubtitleBlock"/>

            <GroupBox Header="主题" Margin="0,0,0,12">
                <StackPanel Margin="8">
                    <Button Name="BtnLoadTheme" Content="加载 Obsidian Glass 主题" Height="36" Margin="0,0,0,8" Click="BtnLoadTheme_Click"/>
                    <TextBlock Name="ThemeInfo" TextWrapping="Wrap" FontSize="12"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="安全备份" Margin="0,0,0,12">
                <StackPanel Margin="8">
                    <Button Name="BtnBackup" Content="创建基线备份" Height="36" Margin="0,0,0,8" Click="BtnBackup_Click"/>
                    <Button Name="BtnRestore" Content="恢复最新基线" Height="36" Margin="0,0,0,8" Click="BtnRestore_Click"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="壁纸" Margin="0,0,0,12">
                <StackPanel Margin="8">
                    <Button Name="BtnSetStatic" Content="设置静态壁纸…" Height="36" Margin="0,0,0,8" Click="BtnSetStatic_Click"/>
                    <Button Name="BtnStartDynamic" Content="启动动态壁纸（mpv）…" Height="36" Margin="0,0,0,8" Click="BtnStartDynamic_Click"/>
                    <Button Name="BtnStartTest" Content="启动测试图案（品红）" Height="36" Margin="0,0,0,8" Click="BtnStartTest_Click"/>
                    <Button Name="BtnStopDynamic" Content="停止动态壁纸" Height="36" Margin="0,0,0,8" Click="BtnStopDynamic_Click"/>
                    <Separator Margin="0,4,0,8"/>
                    <CheckBox Name="ChkAudio" Content="启用声音" Margin="0,0,0,6" Checked="ChkAudio_Changed" Unchecked="ChkAudio_Changed"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Slider Name="VolSlider" Minimum="0" Maximum="100" Value="80" Width="240"
                                IsEnabled="{Binding ElementName=ChkAudio, Path=IsChecked}"
                                VerticalAlignment="Center" ValueChanged="VolSlider_ValueChanged"/>
                        <TextBlock Name="VolLabel" Text="80%" Margin="10,0,0,0" VerticalAlignment="Center"
                                   FontSize="12" Opacity="0.7"/>
                    </StackPanel>
                    <TextBlock Text="默认关闭 —— 壁纸静音，除非你手动开启。" FontSize="10" Opacity="0.6" Margin="0,0,0,8"/>
                    <TextBlock Name="WallpaperInfo" TextWrapping="Wrap" FontSize="12"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="壁纸库" Margin="0,0,0,12">
                <StackPanel Margin="8">
                    <CheckBox Name="ChkRotation" Content="按时间自动轮换壁纸" Margin="0,0,0,8" Checked="ChkRotation_Changed" Unchecked="ChkRotation_Changed"/>
                    <CheckBox Name="ChkLaunchOnBoot" Content="登录 Windows 时自动启动（仅驻留托盘）" Margin="0,0,0,8" Checked="ChkLaunchOnBoot_Changed" Unchecked="ChkLaunchOnBoot_Changed"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="间隔" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Slider Name="IntervalSlider" Minimum="5" Maximum="120" Value="30" Width="200"
                                VerticalAlignment="Center" ValueChanged="IntervalSlider_ValueChanged"/>
                        <TextBlock Name="IntervalLabel" Text="30 分钟" Margin="10,0,0,0" VerticalAlignment="Center"
                                   FontSize="12" Opacity="0.7"/>
                    </StackPanel>
                    <Button Name="BtnRotateNow" Content="立即轮换一张" Height="36" Margin="0,0,0,8" Click="BtnRotateNow_Click"/>
                    <Button Name="BtnOpenLibrary" Content="打开壁纸库文件夹" Height="36" Margin="0,0,0,8" Click="BtnOpenLibrary_Click"/>
                    <TextBlock Name="LibStatus" TextWrapping="Wrap" FontSize="12"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="桌面整理" Margin="0,0,0,12">
                <StackPanel Margin="8">
                    <CheckBox Name="ChkHideIcons" Content="隐藏桌面图标" Margin="0,0,0,6" Checked="ChkHideIcons_Changed" Unchecked="ChkHideIcons_Changed"/>
                    <CheckBox Name="ChkRestoreIconsOnExit" Content="退出时恢复桌面图标（推荐）" Margin="0,0,0,8" Checked="ChkRestoreIcons_Changed" Unchecked="ChkRestoreIcons_Changed"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ComboBox Name="CmbScene" Width="140" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Name="BtnApplyScene" Content="应用场景" Height="30" Click="BtnApplyScene_Click"/>
                    </StackPanel>
                    <TextBlock Name="DesktopStatus" TextWrapping="Wrap" FontSize="12"/>
                    <TextBlock Text="若图标未恢复，可右键桌面 → 查看 → 显示桌面图标。" FontSize="10" Opacity="0.6" Margin="0,4,0,0"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="诊断工具" Margin="0,0,0,12">
                <StackPanel Margin="8">
                    <Button Name="BtnOpenLog" Content="打开壁纸日志" Height="36" Margin="0,0,0,8" Click="BtnOpenLog_Click"/>
                    <Button Name="BtnShowLogTail" Content="显示日志尾部（窗口内）" Height="36" Margin="0,0,0,8" Click="BtnShowLogTail_Click"/>
                    <Button Name="BtnDiagnose" Content="运行壁纸诊断" Height="36" Margin="0,0,0,8" Click="BtnDiagnose_Click"/>
                    <Button Name="BtnCopyDiag" Content="复制诊断信息与日志" Height="36" Margin="0,0,0,8" Click="BtnCopyDiag_Click"/>
                    <TextBox Name="DiagInfo" TextWrapping="Wrap" FontSize="11" FontFamily="Consolas"
                             IsReadOnly="True" AcceptsReturn="True" BorderThickness="0" Padding="0"
                             Background="Transparent" VerticalScrollBarVisibility="Disabled"
                             HorizontalScrollBarVisibility="Disabled"/>
                    <TextBlock Text="选中上方文本后按 Ctrl+C，或使用复制按钮。" FontSize="10" Opacity="0.6" Margin="0,4,0,0"/>
                </StackPanel>
            </GroupBox>

            <TextBox Name="Status" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12"
                     IsReadOnly="True" AcceptsReturn="True" BorderThickness="0" Padding="0"
                     Background="Transparent" VerticalScrollBarVisibility="Disabled"
                     HorizontalScrollBarVisibility="Disabled"/>
        </StackPanel>
    </ScrollViewer>
</Window>
