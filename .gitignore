# ============================================================
# .NET build outputs (compiled binaries, obj trees)
# NOTE: src/DesktopSuite/mpv.exe is a ~112MB binary and is NOT
#       tracked in git — it exceeds GitHub's 100MB hard limit and
#       Gitee free tier has no Git LFS. It is provided locally and
#       fetched/copied into the publish package at build time.
#       See Publish-SelfContained.ps1 (mpv bootstrap) for sourcing.
# ============================================================
src/DesktopSuite/mpv.exe
**/bin/
**/obj/
*.dll
*.pdb
*.ilk
*.exp
*.cache

# ============================================================
# Publish / release artifacts
# ============================================================
publish/

# ============================================================
# VM validation evidence (large, regenerable per run)
# ============================================================
tools/vm-validation/evidence/

# ============================================================
# Logs & scratch
# ============================================================
*.log
_*.txt
_*.ps1
_*.json
_*.log
*.tmp
_*/

# ============================================================
# OS / editor cruft
# ============================================================
Thumbs.db
Desktop.ini
.DS_Store
